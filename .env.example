WAT_BACKEND=firebase

NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
NEXT_PUBLIC_WHATSAPP_NUMBER=REPLACE_WITH_DEFAULT_WHATSAPP_NUMBER
NEXT_PUBLIC_APP_URL=https://REPLACE-WITH-YOUR-PUBLIC-APP-DOMAIN

# Server-only deployment safety switch. Only the exact value "true" enables writes.
WAT_MUTATIONS_ENABLED=false

# Appwrite browser configuration (non-secret)
NEXT_PUBLIC_APPWRITE_ENDPOINT=REPLACE_WITH_APPWRITE_ENDPOINT
NEXT_PUBLIC_APPWRITE_PROJECT_ID=REPLACE_WITH_APPWRITE_PROJECT_ID

# Appwrite server configuration (never expose keys to browser code)
APPWRITE_ENDPOINT=REPLACE_WITH_APPWRITE_ENDPOINT
APPWRITE_PROJECT_ID=REPLACE_WITH_APPWRITE_PROJECT_ID
APPWRITE_EXPECTED_PROJECT_ID=REPLACE_WITH_THE_SAME_EXPECTED_APPWRITE_PROJECT_ID
APPWRITE_DATA_API_KEY=REPLACE_WITH_APPWRITE_DATA_API_KEY
APPWRITE_AUTH_API_KEY=REPLACE_WITH_APPWRITE_AUTH_API_KEY
APPWRITE_BOOTSTRAP_API_KEY=REPLACE_WITH_TEMPORARY_BOOTSTRAP_API_KEY

APPWRITE_DATABASE_ID=wat_app
APPWRITE_TEAM_ID=wat_staff
APPWRITE_PRODUCT_IMAGES_BUCKET_ID=product_images
APPWRITE_PRODUCTS_TABLE_ID=products
APPWRITE_CATEGORIES_TABLE_ID=categories
APPWRITE_ACTIVITY_LOGS_TABLE_ID=activity_logs
APPWRITE_ANALYTICS_EVENTS_TABLE_ID=analytics_events
APPWRITE_BROADCASTS_TABLE_ID=broadcasts

APPWRITE_SESSION_COOKIE_NAME=wat-appwrite-session
APPWRITE_PASSWORD_RECOVERY_URL=http://localhost:3000/admin/reset-password
