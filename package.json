    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
