    "appwrite:check-empty": "tsx --conditions=react-server scripts/appwrite-empty-state-check.ts",
    "appwrite:check-file": "tsx --conditions=react-server scripts/appwrite-file-verification.ts",
    "appwrite:check-auth": "tsx --conditions=react-server scripts/appwrite-auth-verification.ts",
    "appwrite:check-admin-catalogue": "tsx --conditions=react-server scripts/appwrite-admin-catalogue-verification.ts"
