rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Storefront (public reads) ──────────────────────────
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'aqueelfirdausi@gmail.com';
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'aqueelfirdausi@gmail.com';
    }

    match /broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'aqueelfirdausi@gmail.com';
    }

    // ── Admin only ─────────────────────────────────────────
    match /logs/{logId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'aqueelfirdausi@gmail.com';
    }

    match /analyticsEvents/{eventId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'aqueelfirdausi@gmail.com';
    }

    match /fcm_tokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.token.email == 'aqueelfirdausi@gmail.com';
    }

    // ── Deny everything else ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}